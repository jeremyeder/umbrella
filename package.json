{
  "name": "@vteam/acp-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for vTeam ACP (Agentic Code Platform) APIs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "acp-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "acp",
    "vteam",
    "claude",
    "ai-assistant"
  ],
  "author": "vTeam",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "cosmiconfig": "^9.0.0",
    "deepmerge": "^4.3.1",
    "undici": "^7.16.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^4.0.2",
    "@vitest/ui": "^4.0.2",
    "msw": "^2.11.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.2"
  }
}
